<Window x:Class="LocalFileDB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assest/main-icon.png"
        Title="{Binding WindowTitle}" Height="700" Width="1280" MinWidth="950" MinHeight="450"
        Closing="Window_Closing">
    <!-- Keep view-only converters in XAML; screen state comes from the ViewModel. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New database..." Command="{Binding NewDatabaseCommand}" />
                <MenuItem Header="_Open database..." Command="{Binding OpenDatabaseCommand}" />
                <MenuItem Header="Recent databases" ItemsSource="{Binding RecentDatabases}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Add files..." Command="{Binding AddFilesCommand}" />
                <MenuItem Header="_Remove selected file" Command="{Binding RemoveSelectedFileCommand}" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveDatabaseCommand}" />
                <MenuItem Header="Save _as..." Command="{Binding SaveDatabaseAsCommand}" IsEnabled="{Binding IsDatabaseOpen}" />
            </MenuItem>
        </Menu>

        <DockPanel Margin="16">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Database name" FontWeight="SemiBold" />
                    <TextBox Margin="0,4,0,8"
                             Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsDatabaseOpen}" />
                    <TextBlock Text="{Binding DatabaseFilePath}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="Root directory" FontWeight="SemiBold" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseRootDirectoryCommand}" />
                        <TextBox Text="{Binding RootDirectory, Mode=OneWay}" Margin="0,0,8,0" IsReadOnly="True" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="File name" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox Margin="0,4,0,0"
                             Text="{Binding FileNameFilter, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsDatabaseOpen}" />
                    <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <Menu HorizontalAlignment="Left">
                        <MenuItem Header="{Binding TagFilterSummary}"
                                  ItemsSource="{Binding AvailableTags}"
                                  IsEnabled="{Binding IsDatabaseOpen}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="StaysOpenOnClick" Value="True" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>
                    <TextBlock Text="Matches files with any selected tag." Foreground="Gray" FontSize="11" />
                    <CheckBox Content="Only missing files"
                              IsChecked="{Binding OnlyMissingFiles, Mode=TwoWay}"
                              IsEnabled="{Binding IsDatabaseOpen}"
                              Margin="0,8,0,0" />
                    <Button Content="Reset filters"
                            Command="{Binding ResetFiltersCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- The catalog list and read-only file preview share the workspace. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding DisplayedFiles}"
                          SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          CanUserAddRows="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Remove from database"
                                                  Command="{Binding PlacementTarget.DataContext.RemoveCommand,
                                                                    RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding ResolvedPath}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding MediaType}" Width="85" />
                        <DataGridTextColumn Header="Tags" Binding="{Binding TagsText}" Width="210" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" SortMemberPath="Exists" Width="90" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="85" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedText}" SortMemberPath="LastModified" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewMessage}" Foreground="Gray" TextWrapping="Wrap" />
                            <StackPanel Visibility="{Binding HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Preview" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding SelectedFile.FileName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Path" FontWeight="SemiBold" Margin="0,12,0,2" />
                                <TextBlock Text="{Binding SelectedFile.ResolvedPath}" TextWrapping="Wrap" />
                                <Border BorderBrush="#D0D0D0" BorderThickness="1" Margin="0,16,0,0" MinHeight="220" Background="#F7F7F7">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="420" />
                                </Border>
                                <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,12,0,2" />
                                <ItemsControl ItemsSource="{Binding SelectedFile.TagOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsAssigned, Mode=TwoWay}"
                                                      Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Content="Add tag"
                                            Command="{Binding AddTagCommand}"
                                            Margin="8,0,0,0" />
                                    <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Enter a new tag name" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
